{
  "name": "kvsk-payroll",
  "version": "2.1.0",
  "description": "KVSK Payroll & Attendance System - Desktop",
  "main": "main.js",
  "author": "KVSK",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "build": "electron-builder",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.kvsk.payroll",
    "productName": "KVSK Payroll",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist",
      "!node_modules/electron-builder",
      "!node_modules/electron"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": null
    },
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "public/uploads",
        "to": "public/uploads",
        "filter": ["**/*"]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.2",
    "helmet": "^8.2.0",
    "multer": "^2.2.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3"
  }
}
