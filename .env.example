# Payroll and Attendance System - Environment Configuration

PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgres://username:password@localhost:5432/payroll_attendance

# Session secret for encrypting cookies (CHANGE THIS in production!)
SESSION_SECRET=change-this-to-a-random-secret-string

# Auto-create an admin user on first run
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=change-this-admin-password
BOOTSTRAP_ROLE=admin

# Auto-create an HR user on first run
BOOTSTRAP_HR_USERNAME=hr
BOOTSTRAP_HR_PASSWORD=change-this-hr-password
BOOTSTRAP_HR_ROLE=hr

# Node environment (set to production in production)
NODE_ENV=development

# Path to pg_dump executable (auto-detected if not set)
# PG_DUMP_PATH=/usr/bin/pg_dump
