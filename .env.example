# Payroll and Attendance System - Environment Configuration
# Copy this file to .env and fill in your values

PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/payroll_attendance

# Session secret for encrypting cookies (use a long random string)
SESSION_SECRET=change_this_to_a_random_secret_string

# Auto-create an admin user on first run
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=change_this_admin_password
BOOTSTRAP_ROLE=admin

# Path to pg_dump executable (auto-detected if not set)
# PG_DUMP_PATH=/usr/bin/pg_dump
