# Payroll and Attendance System - Environment Configuration
# Copy this file to .env and fill in your values

PORT=3001

# PostgreSQL connection string
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/payroll_attendance

# Session secret for encrypting cookies (change this to a random string)
SESSION_SECRET=change-this-to-a-random-secret-string

# Optional: Auto-create an admin/HR user on first run
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=your_admin_password
BOOTSTRAP_ROLE=admin
